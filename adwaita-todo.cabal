cabal-version: 3.0
name: adwaita-todo
version: 0.1.0.0
build-type: Simple
tested-with: ghc ==9.14.1

common extensions
  default-language: GHC2024
  default-extensions:
    DerivingStrategies
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    StrictData

common ghc-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -fhide-source-paths
    -Wno-unused-do-bind
    -fshow-hole-constraints
    -Wno-unticked-promoted-constructors

library
  import: extensions
  import: ghc-options
  hs-source-dirs: src
  -- cabal-gild: discover src/
  exposed-modules:
    Todo.Model
    Todo.Runtime
    Todo.View

  build-depends:
    base >=4.22,
    containers,
    gi-adwaita ^>=1.0.8,
    gi-gio ^>=2.0.38,
    gi-glib ^>=2.0.30,
    gi-gtk4 ^>=4.0.12,
    haskell-gi-base ^>=0.26.9,
    text,

executable adwaita-todo
  import: extensions
  import: ghc-options
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded
  build-depends:
    adwaita-todo,
    base,
    gi-adwaita ^>=1.0.8,
    gi-gio ^>=2.0.38,
    gi-gtk4 ^>=4.0.12,
    haskell-gi-base ^>=0.26.9,
